# ZERO ROT backend configuration. Copy to `.env` (never commit `.env`).
# Every key here is read only by the backend; nothing is sent to the browser.

# --- Core ---
ENVIRONMENT=development                 # production enforces JWT_SECRET and PostgreSQL
# DATABASE_URL defaults to backend/zerorot.db (SQLite). For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/zerorot
# DATABASE_URL=
JWT_SECRET=                             # long random string; required in production (python -c "import secrets;print(secrets.token_urlsafe(48))")
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
PUBLIC_BASE_URL=                        # e.g. https://zerorot.example.in — used in QR links (phones must reach it)
RATE_LIMIT_PER_MINUTE=120

# --- AI explanations (Groq). Numbers never come from the LLM. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20

# --- Verified market prices (Agmarknet via data.gov.in) ---
DATA_GOV_API_KEY=                       # free key from https://data.gov.in (without it prices show DATA UNAVAILABLE)
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_HISTORY_RESOURCE_ID=          # optional historical resource id for forecasting (needs >= 60 daily points)

# --- Live weather and routing (no key needed) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OSRM_BASE_URL=https://router.project-osrm.org

# --- Web push (VAPID). Leave empty to auto-generate into backend/.vapid.json ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Computer vision ---
# Reserved for a trained ONNX classifier. ONNX inference is NOT implemented yet: inspection always uses the
# classical OpenCV analysis and labels it as such.
# CV_MODEL_PATH=/absolute/path/to/produce_classifier.onnx   (default: backend/models/produce_classifier.onnx)

# --- Docker Compose only ---
POSTGRES_PASSWORD=                      # required by docker-compose.yml for the bundled PostgreSQL
# VAPID_KEY_FILE=                       # where auto-generated VAPID keys are stored (compose sets a volume path)
